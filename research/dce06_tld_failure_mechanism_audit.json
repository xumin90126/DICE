  "band_analysis": {
    "finding": "TLD band formation only breaks on is_wide_text (single-fragment, width > 0.40*page_width, text > 40 chars). Multi-fragment prose (from PDF citation/math splitting) appears as is_multicol=True and does NOT break the band.",
    "band_breaker_logic": "is_wide_text is the ONLY breaker. is_multicol = anchor. is_short_single + OTHER = absorb.",
    "failure_band_pattern": "Small table (11-15% of page) + no wide_text below table → band extends to page bottom → contamination",
    "success_band_pattern": "Table dominates page (95-97%) → global band = table → no contamination",
    "contamination_source": "TLD band formation itself (page-global, no locality constraint). NOT line grouping."
  },
