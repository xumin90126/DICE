      "reusable": "Design feedback"
    },
    {
      "type": "Human Semantic Interpretation",
      "description": "Semantic judgment",
      "reusable": "Semantic (Human authority)"
    },
    {
      "type": "One-off Case Judgment",
      "description": "Decision without explanation",
      "reusable": "Not reusable alone"
    }
