  "reusability_boundary": {
    "system_can": [
      "Group cases by structural signature (Aggregation, frozen)",
      "Compress groups into summaries (Compression, frozen)",
      "Detect structural similarity (Aggregation signature)",
      "Extract evidence fields per case (Sampling frame)",
      "Match new case to existing group (concept exists)",
      "Present evidence cue to Human (L5.10 translation table)"
    ],
    "human_must": [
      "Semantic interpretation (no System semantic capability)",
      "Boundary adequacy judgment",
      "Scope acceptance for reusable signal",
      "Final validation of reusable knowledge (authority=0 at L5)",
      "Override of System proposal (automation bias prevention)",
      "UNKNOWN selection when uncertain"
    ],
    "principle": "System may propose reusable knowledge; only Human validation can grant reusable semantic authority."
  },
  "learning_definition": {
    "learning_true_requires_all": [
      "Feedback accumulated (multiple feedbacks for similar patterns)",
      "Signal extracted (reusable signals identified)",
      "Signal validated (Human validated as reusable)",
      "Signal applied (to NEW cases, not originals)",
      "Effort reduced (review count or time DECREASED)",
      "Quality maintained (accuracy NOT decreased)",
      "Error recurrence reduced (same error type less frequent)"
    ],
    "not_learning": [
      "Storage (feedback in database)",
      "Retrieval (keyword search)",
      "Aggregation (similar feedbacks grouped)",
      "Candidate Discovery (recurring signal identified)",
      "Validation (signal validated)",
      "Reuse Attempt (signal shown for new case)"
    ],
    "learning_equals": "REUSE WITH MEASURED EFFORT REDUCTION + QUALITY MAINTENANCE"
  },
