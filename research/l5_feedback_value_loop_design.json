  "evaluation_metrics": [
    {
      "metric": "Human Effort Reduction",
      "type": "CONCEPTUAL",
      "definition": "(baseline_time - reuse_time) / baseline_time"
    },
    {
      "metric": "Feedback Reuse Ratio",
      "type": "CONCEPTUAL",
      "definition": "cases_covered_by_reuse / total_new_cases"
    },
    {
      "metric": "Generalization Scope",
      "type": "CONCEPTUAL",
      "definition": "{same_doc, same_family, cross_doc, cross_domain}"
    },
    {
      "metric": "Decision Quality",
      "type": "CONCEPTUAL",
      "definition": "accuracy maintained or improved after reuse"
    },
    {
      "metric": "Error Recurrence Rate",
      "type": "CONCEPTUAL",
      "definition": "same_error_type_count_batch2 / batch2_total"
    },
    {
      "metric": "UNKNOWN Preservation",
      "type": "CONCEPTUAL",
      "definition": "unknown_count not suppressed by reuse"
    },
    {
      "metric": "Automation Bias Index",
      "type": "CONCEPTUAL",
      "definition": "blind_accept_rate / total_reuse_matches"
    },
    {
      "metric": "Provenance Completeness",
      "type": "CONCEPTUAL",
      "definition": "feedback->evidence->signal->validation chain traceable"
    },
    {
      "metric": "Signal Extraction Precision",
      "type": "CONCEPTUAL",
      "definition": "correct_signals / extracted_signals"
    },
    {
      "metric": "Signal Recurrence Rate",
      "type": "CONCEPTUAL",
      "definition": "recurring_signals / total_extracted_signals"
    }
  ],
  "minimal_experiment_design": {
    "goal": "Prove Feedback -> Reuse -> Effort Reduction + Quality Maintenance",
    "phases": [
      {
        "phase": 1,
        "name": "Baseline",
        "participants": 10,
        "cases": 50,
        "measure": "review_time, accuracy, UNKNOWN, expansion"
      },
      {
        "phase": 2,
        "name": "Signal Extraction",
        "description": "Extract signals from Phase 1 feedbacks offline"
      },
      {
        "phase": 3,
        "name": "Signal Validation",
        "validators": 3,
        "description": "Validate candidate signals, specify scope"
      },
      {
        "phase": 4,
        "name": "Treatment",
        "participants": 10,
        "cases": "50 old + 50 new",
        "description": "Show validated signals for matching cases"
      },
      {
        "phase": 5,
        "name": "Comparison",
        "description": "Compare baseline vs treatment on all metrics"
      }
    ],
    "critical_controls": [
      "System!=GT test cases (>=10) for automation bias",
      "Conflict cases (>=5) for signal override",
      "Cross-document cases (>=20) for generalization",
      "Signal shown as CANDIDATE not conclusion"
    ],
    "prerequisites": [
      "n>5 Phase 1 participants for signal extraction",
      "Diverse case corpus (not just tables)",
      "Evidence Cue implementation (L5.10 design-ready)",
      "Feedback signal extraction process (design identified)"
    ],
    "not_implemented": true
  },
