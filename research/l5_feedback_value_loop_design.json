      "status": "CANDIDATE"
    },
    "not_a_rule": true,
    "not_a_classifier": true,
    "not_automatic": true
  },
  "feedback_lifecycle": [
    {
      "state": "Raw Human Feedback",
      "why": "Human output must be captured",
      "independent_object": false,
      "status": "IMPLEMENTED"
    },
    {
      "state": "Evidence-Linked Feedback",
      "why": "Feedback must connect to evidence",
      "independent_object": false,
      "status": "PARTIAL"
    },
