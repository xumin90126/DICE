  "minimum_reusable_unit": {
    "description": "A single decision is NOT reusable. A Potentially Reusable Signal links Human reasoning to Evidence.",
    "example": {
      "signal_type": "TABLE_DIFFERENT_COLUMNS",
      "evidence_basis": "TLD is_in_table=True, different_cell=True",
      "human_observation": "表格中同一行的不同列数据",
