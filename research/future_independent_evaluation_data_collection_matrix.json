  "processing_boundary": {
    "layer_a_corpus_preprocessing": {
      "description": "Frozen P1-P6 pipeline processing",
      "allowed": true,
      "includes": [
        "P1 text extraction",
        "P2 geometry",
        "P3 style",
        "P4 span",
        "P5 reading order",
        "P6 region"
      ],
      "breaks_independence": false
    },
    "layer_b_experimental_feature_observation": {
      "description": "IS-01/IS-02 computation",
      "allowed": "ONLY AFTER Evaluation Set Freeze",
      "includes": [
        "IS-01 number pattern",
        "IS-02 readable title",
        "IS-07 visual context"
      ],
      "breaks_independence": "YES if computed before Human GT"
    },
    "layer_c_decision_leakage": {
      "description": "Using IS results to filter/adjust sampling or GT",
      "allowed": false,
      "includes": [
        "IS-based case selection",
        "IS-based GT modification",
        "Feature modification after results"
      ],
      "breaks_independence": true
    }
  },
  "workflow_stages": [
    {
      "stage": "Phase A: Corpus Processing",
      "actions": [
        "Process PDFs through frozen P1-P6",
        "Extract same-y unmerged pairs",
        "Apply AMBIGUOUS criteria"
      ],
      "machine_features_visible": false,
      "reviewer_blind": "N/A",
      "semantic_gt_required": false,
      "freeze_required": false,
      "stop_condition": "If no AMBIGUOUS cases found"
    },
    {
      "stage": "Phase B: Candidate Sampling",
      "actions": [
        "Stratified sampling (geometric only)",
        "Record sampling frame",
        "NO IS computation"
      ],
      "machine_features_visible": false,
      "reviewer_blind": "N/A",
      "semantic_gt_required": false,
      "freeze_required": false,
      "stop_condition": "If < 20 TOC/APPENDIX candidates"
    },
    {
      "stage": "Phase C: Blind Human GT",
      "actions": [
        "Reviewer A blind review",
        "Reviewer B blind review",
        "Compute kappa",
        "Adjudicate disagreements"
      ],
      "machine_features_visible": false,
      "reviewer_blind": true,
      "semantic_gt_required": true,
      "second_reviewer_required": true,
      "adjudication_required": "If disagreement",
      "freeze_required": false,
      "stop_condition": "If kappa < 0.60"
    },
    {
      "stage": "Phase D: Evaluation Set Freeze",
      "actions": [
        "Freeze sample",
        "Freeze GT",
        "Freeze inclusion criteria"
      ],
      "machine_features_visible": false,
      "reviewer_blind": "N/A (frozen)",
      "semantic_gt_required": true,
      "freeze_required": true,
      "stop_condition": "N/A"
    },
    {
      "stage": "Phase E: Frozen Feature Observation",
      "actions": [
        "Compute IS-01 (frozen)",
        "Compute IS-02 (frozen)",
        "NO modification"
      ],
      "machine_features_visible": true,
      "reviewer_blind": "N/A",
      "semantic_gt_required": true,
      "freeze_required": true,
      "stop_condition": "If feature modification attempted"
    },
    {
      "stage": "Phase F: Machine Assessment",
      "actions": [
        "Output MACHINE_DECISION",
        "Compare against frozen GT"
      ],
      "machine_features_visible": true,
      "reviewer_blind": "N/A",
      "semantic_gt_required": true,
      "freeze_required": true,
      "stop_condition": "If GT modification attempted"
    },
    {
      "stage": "Phase G: Metrics & Gate",
      "actions": [
        "Compute Precision/Recall/FP/Shrinkage",
        "Evaluate G1-G12"
      ],
      "machine_features_visible": true,
      "reviewer_blind": "N/A",
      "semantic_gt_required": true,
      "freeze_required": true,
      "stop_condition": "If feature modification based on results"
    }
  ],
